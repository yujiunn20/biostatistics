---
import Base from "../../../layouts/Base.astro";
import Shell from "../../../components/Shell.astro";
import { localizedSectionsForChapter } from "../../../lib/localized-content";
import { chapters, chapterTitle, locales, ui, type Locale } from "../../../lib/site";
export function getStaticPaths(){ return locales.flatMap(locale => chapters.map(chapter => ({ params: { locale, id: chapter.id } }))); }
const locale = Astro.params.locale as Locale;
const id = Astro.params.id!;
const index = chapters.findIndex(chapter => chapter.id === id);
const chapter = chapters[index];
const sections = localizedSectionsForChapter(locale, id);
const isPublished = sections.length > 0;
const t = ui[locale];
const title = chapterTitle(chapter, locale);
const alternates = Object.fromEntries(locales.map(lang => [lang, `/${lang}/chapter/${id}/`])) as Record<Locale,string>;
const previous = index > 0 ? chapters[index - 1] : undefined;
const next = index < chapters.length - 1 ? chapters[index + 1] : undefined;
---
<Base locale={locale} title={`${title} | ${t.site}`} description={`${title} — ${t.tag}`} alternates={alternates}>
  <Shell locale={locale} activeId={id}>
    {isPublished && <article class="chapter-overview">
      <header class="article-head"><p class="eyebrow">{chapter.id === "10" ? "CONCLUSION" : `CHAPTER ${chapter.id}`}</p><h1>{title}</h1><p>{chapter.titleEn}</p></header>
      <section class="chapter-intro"><div><p class="eyebrow">LEARNING PATH</p><h2>{locale === "ja" ? "この章のトピック" : locale === "en" ? "Topics in this chapter" : "本章主題"}</h2><p>{locale === "ja" ? "トピックごとに読み進めます。原ノートの説明、数式、表を保ちながら日本語で再構成しています。" : locale === "en" ? "Read by topic; each article preserves the complete explanations, formulas, and tables from the original notes." : "依照主題分篇閱讀；每篇保留原筆記中的完整段落、公式與表格。"}</p></div><span><b>{sections.length}</b> {locale === "ja" ? "本の記事" : locale === "en" ? "topic articles" : "篇主題文章"}</span></section>
      <ol class="topic-grid">{sections.map((section, sectionIndex) => <li><a href={`/${locale}/chapter/${id}/${section.slug}/`}><span>{String(sectionIndex + 1).padStart(2, "0")}</span><div><h2>{section.title}</h2><p>{section.summary}</p><small>{section.blocks.length} {locale === "ja" ? "コンテンツブロック" : locale === "en" ? "content blocks" : "個內容區塊"}</small></div><b aria-hidden="true">→</b></a></li>)}</ol>
      <nav class="pager chapter-pager">
        {previous ? <a href={`/${locale}/chapter/${previous.id}/`}><small>{t.prev}</small><b>← {chapterTitle(previous, locale)}</b></a> : <span></span>}
        {next ? <a href={`/${locale}/chapter/${next.id}/`}><small>{t.next}</small><b>{chapterTitle(next, locale)} →</b></a> : <span></span>}
      </nav>
    </article>}
    {!isPublished && <section class="pending"><p class="eyebrow">{chapter.id === "10" ? "CONCLUSION" : `CHAPTER ${chapter.id}`}</p><h1>{title}</h1><div><b>文</b><h2>{t.pending}</h2><p>{t.notice}</p><a class="primary" href={`/zh-Hant/chapter/${chapter.id}/`}>{t.readZh} →</a></div></section>}
  </Shell>
</Base>
