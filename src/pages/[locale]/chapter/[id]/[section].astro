---
import Base from "../../../../layouts/Base.astro";
import Shell from "../../../../components/Shell.astro";
import ArticleBlock from "../../../../components/ArticleBlock.astro";
import RelatedReading from "../../../../components/RelatedReading.astro";
import { allTopicSections } from "../../../../lib/content";
import { allEnglishTopicSections, allJapaneseTopicSections, localizedSectionsForChapter } from "../../../../lib/localized-content";
import type { ArticleKey } from "../../../../data/article-relations";
import { chapters, chapterTitle, ui, type Locale } from "../../../../lib/site";
export function getStaticPaths(){ return [
  ...allTopicSections.map(section => ({ params: { locale: "zh-Hant", id: section.chapterId, section: section.slug } })),
  ...allEnglishTopicSections.map(section => ({ params: { locale: "en", id: section.chapterId, section: section.slug } })),
  ...allJapaneseTopicSections.map(section => ({ params: { locale: "ja", id: section.chapterId, section: section.slug } })),
]; }
const locale = Astro.params.locale as Locale;
const id = Astro.params.id!;
const slug = Astro.params.section!;
const chapter = chapters.find(item => item.id === id)!;
const sections = localizedSectionsForChapter(locale, id);
const sectionIndex = sections.findIndex(item => item.slug === slug);
const section = sections[sectionIndex];
const previous = sectionIndex > 0 ? sections[sectionIndex - 1] : undefined;
const next = sectionIndex < sections.length - 1 ? sections[sectionIndex + 1] : undefined;
const usedHeadingIds = new Map<string, number>();
const internalHeadings = section.blocks.flatMap((block, blockIndex) => {
  if (block.type !== "heading") return [];
  const text = "text" in block ? block.text : "";
  const base = String(text || "section").normalize("NFKC").toLocaleLowerCase()
    .replace(/[^\p{Letter}\p{Number}]+/gu, "-").replace(/^-|-$/g, "") || "section";
  const occurrence = (usedHeadingIds.get(base) ?? 0) + 1;
  usedHeadingIds.set(base, occurrence);
  return [{ blockIndex, text, id: occurrence === 1 ? base : `${base}-${occurrence}` }];
});
const headingIds = new Map(internalHeadings.map(item => [item.blockIndex, item.id]));
const t = ui[locale];
---
<Base locale={locale} title={`${section.title} | ${chapterTitle(chapter, locale)} | ${t.site}`} description={section.summary}>
  <Shell locale={locale} activeId={id} sectionSlug={slug}>
    <article class="topic-article">
      <nav class="breadcrumbs" aria-label={locale === "ja" ? "パンくずリスト" : locale === "en" ? "Breadcrumb" : "麵包屑"}><a href={`/${locale}/`}>{locale === "ja" ? "ホーム" : locale === "en" ? "Home" : "首頁"}</a><span>/</span><a href={`/${locale}/chapter/${id}/`}>{chapterTitle(chapter, locale)}</a><span>/</span><span>{section.title}</span></nav>
      <header class="article-head"><p class="eyebrow">{chapter.id === "10" ? "CONCLUSION" : `CHAPTER ${chapter.id} · TOPIC ${String(sectionIndex + 1).padStart(2, "0")}`}</p><h1>{section.title}</h1><p>{section.summary}</p></header>
      <div class="topic-layout">
        <aside class="topic-toc"><p>{locale === "ja" ? "この章のトピック" : locale === "en" ? "Topics in this chapter" : "本章主題"}</p><nav>{sections.map((item, index) => <a class={item.slug === slug ? "active" : ""} href={`/${locale}/chapter/${id}/${item.slug}/`}><span>{String(index + 1).padStart(2, "0")}</span>{item.title}</a>)}</nav></aside>
        <div>{internalHeadings.length > 0 && <details class="on-page-toc"><summary>{locale === "ja" ? "このページの内容" : locale === "en" ? "On this page" : "本頁內容"}</summary><ol>{internalHeadings.map(item => <li><a href={`#${item.id}`}>{item.text}</a></li>)}</ol></details>}<section class="prose">{section.blocks.map((block, blockIndex) => <ArticleBlock block={block} headingId={headingIds.get(blockIndex)} locale={locale} />)}</section></div>
      </div>
      <RelatedReading currentKey={`${id}/${slug}` as ArticleKey} locale={locale} />
      <nav class="pager">
        {previous ? <a href={`/${locale}/chapter/${id}/${previous.slug}/`}><small>{locale === "ja" ? "前の記事" : locale === "en" ? "Previous article" : "上一篇"}</small><b>← {previous.title}</b></a> : <a href={`/${locale}/chapter/${id}/`}><small>{locale === "ja" ? "戻る" : locale === "en" ? "Back" : "返回"}</small><b>← {chapterTitle(chapter, locale)}</b></a>}
        {next ? <a href={`/${locale}/chapter/${id}/${next.slug}/`}><small>{locale === "ja" ? "次の記事" : locale === "en" ? "Next article" : "下一篇"}</small><b>{next.title} →</b></a> : <a href={`/${locale}/chapter/${id}/`}><small>{locale === "ja" ? "この章を完了" : locale === "en" ? "Chapter complete" : "完成本章"}</small><b>{locale === "ja" ? "章の一覧へ戻る" : locale === "en" ? "Back to chapter overview" : "回到章節目錄"} →</b></a>}
      </nav>
    </article>
  </Shell>
</Base>
