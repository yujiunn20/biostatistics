---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import type { Locale } from "../lib/site";
interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates?: Partial<Record<Locale, string>>;
  canonical?: string;
}
const { locale, title, description, alternates, canonical } = Astro.props;
const siteBase = Astro.site ?? Astro.url;
const canonicalHref = new URL(canonical ?? Astro.url.pathname, siteBase).href;
const absoluteAlternates = alternates
  ? Object.fromEntries(Object.entries(alternates).map(([lang, href]) => [lang, new URL(href, siteBase).href]))
  : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#205d49" />
    <link rel="icon" type="image/png" href="/biostatistics-logo.png" />
    <link rel="canonical" href={canonicalHref} />
    <title>{title}</title>
    {absoluteAlternates && Object.entries(absoluteAlternates).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={href} />)}
    {absoluteAlternates?.["zh-Hant"] && <link rel="alternate" hreflang="x-default" href={absoluteAlternates["zh-Hant"]} />}
  </head>
  <body><slot /></body>
</html>
