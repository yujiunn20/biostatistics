---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getFigure, type FigureDefinition } from "../data/figures";
import Formula from "./Formula.astro";
import RichText from "./RichText.astro";
interface RichPart { type: "text" | "inlineFormula"; text?: string; latex?: string; fallback?: string }
interface TableCell { text?: string; parts?: RichPart[] }
interface Props { block: { type: string; text?: string; label?: string; tone?: string; ordered?: boolean; items?: string[]; latex?: string; fallback?: string; parts?: RichPart[]; rows?: (string | TableCell)[][]; imageId?: string; src?: string; alt?: string; caption?: string; credit?: string; sourceUrl?: string; license?: string; width?: number; height?: number } }
const { block } = Astro.props;
const ListTag = block.ordered ? "ol" : "ul";
let figure: FigureDefinition | undefined;
if (block.type === "image") {
  figure = block.imageId ? getFigure(block.imageId) : block.src ? {
    src: block.src,
    alt: block.alt ?? "",
    caption: block.caption,
    credit: block.credit,
    sourceUrl: block.sourceUrl,
    license: block.license,
    width: block.width,
    height: block.height,
  } : undefined;
  if (!figure) throw new Error(`Unknown or incomplete figure: ${block.imageId ?? "missing imageId"}`);
  if (figure.src.startsWith("/") && !existsSync(join(process.cwd(), "public", figure.src))) {
    throw new Error(`Figure file does not exist: ${figure.src}`);
  }
}
---
{block.type === "heading" && <h2>{block.parts ? <RichText parts={block.parts} /> : block.text}</h2>}
{block.type === "paragraph" && <p>{block.text}</p>}
{block.type === "richText" && block.parts && <p><RichText parts={block.parts} /></p>}
{block.type === "list" && block.items && <ListTag class="article-list">{block.items.map(item => <li>{item}</li>)}</ListTag>}
{block.type === "callout" && <aside class:list={["article-callout", block.tone]}><strong>{block.label}</strong><p>{block.text}</p></aside>}
{block.type === "formula" && block.latex && <div class="formula-block"><Formula latex={block.latex} fallback={block.fallback} display /></div>}
{block.type === "table" && block.rows && <div class="tablewrap"><table><tbody>{block.rows.map(row => <tr>{row.map(cell => <td>{typeof cell === "string" ? cell : cell.parts ? <RichText parts={cell.parts} /> : cell.text}</td>)}</tr>)}</tbody></table></div>}
{block.type === "image" && figure && <figure class="article-figure"><img src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" decoding="async" />{(figure.caption || figure.credit) && <figcaption><span>{figure.caption}</span>{figure.credit && <small>{figure.sourceUrl ? <a href={figure.sourceUrl} target="_blank" rel="noopener noreferrer">來源：{figure.credit}</a> : `來源：${figure.credit}`}{figure.license && ` · ${figure.license}`}</small>}</figcaption>}</figure>}
