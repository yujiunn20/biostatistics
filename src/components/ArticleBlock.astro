---
interface Props { block: { type: string; text?: string; rows?: string[][]; src?: string; alt?: string; caption?: string } }
const { block } = Astro.props;
---
{block.type === "heading" && <h2>{block.text}</h2>}
{block.type === "paragraph" && <p>{block.text}</p>}
{block.type === "table" && block.rows && <div class="tablewrap"><table><tbody>{block.rows.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div>}
{block.type === "image" && block.src && <figure class="article-figure"><img src={block.src} alt={block.alt ?? ""} loading="lazy" />{block.caption && <figcaption>{block.caption}</figcaption>}</figure>}
