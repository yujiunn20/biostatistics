---
import { navigatorCopy, navigatorPanels } from "../data/statistical-method-navigator";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = navigatorCopy;
---

<section id="method-navigator" class="method-navigator" aria-labelledby="method-navigator-title" data-method-navigator>
  <header class="method-navigator__header">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="method-navigator-title">{copy.title[locale]}</h2>
    </div>
    <p>{copy.intro[locale]}</p>
  </header>

  <div class="method-navigator__tabs" role="tablist" aria-label={copy.title[locale]}>
    {navigatorPanels.map((panel, index) => (
      <button
        type="button"
        role="tab"
        id={`method-tab-${panel.id}`}
        aria-controls={`method-panel-${panel.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-method-tab={panel.id}
      >
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        {panel.tab[locale]}
      </button>
    ))}
  </div>

  {navigatorPanels.map((panel, panelIndex) => (
    <section
      class="method-panel"
      id={`method-panel-${panel.id}`}
      role="tabpanel"
      aria-labelledby={`method-tab-${panel.id}`}
      hidden={panelIndex !== 0}
      data-method-panel={panel.id}
    >
      <p class="method-panel__prompt">{panel.prompt[locale]}</p>
      <div class="method-panel__columns" aria-hidden="true">
        <span>{copy.columns.source[locale]}</span>
        <span>{copy.columns.condition[locale]}</span>
        <span>{copy.columns.method[locale]}</span>
      </div>

      <div class="method-flow">
        {panel.groups.map((group, groupIndex) => (
          <section class="method-group">
            <h3>
              <span aria-hidden="true">{String(groupIndex + 1).padStart(2, "0")}</span>
              {group.source[locale]}
            </h3>
            <div class="method-group__branches">
              {group.branches.map(branch => (
                <div class="method-branch">
                  <p>{branch.condition[locale]}</p>
                  <div class="method-links">
                    {branch.methods.map(method => (
                      <a href={method.href} lang="en">
                        <span>{method.label}</span>
                        <b aria-hidden="true">↗</b>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  ))}

  <p class="method-navigator__note">{copy.note[locale]}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-method-navigator]").forEach(navigator => {
    const tabs = Array.from(navigator.querySelectorAll<HTMLButtonElement>("[data-method-tab]"));
    const panels = Array.from(navigator.querySelectorAll<HTMLElement>("[data-method-panel]"));

    const selectTab = (tab: HTMLButtonElement, moveFocus = false) => {
      const selectedId = tab.dataset.methodTab;
      tabs.forEach(item => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      panels.forEach(panel => {
        panel.hidden = panel.dataset.methodPanel !== selectedId;
      });
      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", event => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        if (event.key === "Home") nextIndex = 0;
        if (event.key === "End") nextIndex = tabs.length - 1;
        selectTab(tabs[nextIndex], true);
      });
    });
  });
</script>

<style>
  .method-navigator {
    padding: 72px clamp(28px, 5vw, 76px);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .method-navigator__header {
    display: grid;
    grid-template-columns: minmax(280px, .9fr) minmax(360px, 1.1fr);
    gap: clamp(34px, 7vw, 110px);
    align-items: end;
    margin-bottom: 34px;
  }

  .method-navigator__header .eyebrow {
    margin-bottom: 12px;
  }

  .method-navigator__header h2 {
    margin: 0;
    font: 600 36px/1.25 Georgia, "Noto Serif TC", serif;
  }

  .method-navigator__header > p {
    max-width: 690px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }

  .method-navigator__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .method-navigator__tabs button {
    min-height: 62px;
    padding: 12px 18px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }

  .method-navigator__tabs button:last-child {
    border-right: 0;
  }

  .method-navigator__tabs button span {
    margin-right: 12px;
    color: var(--green);
    font: 700 11px/1 ui-monospace;
  }

  .method-navigator__tabs button:hover {
    background: color-mix(in srgb, var(--mint) 38%, transparent);
    color: var(--ink);
  }

  .method-navigator__tabs button[aria-selected="true"] {
    background: var(--mint);
    color: var(--green);
  }

  .method-navigator__tabs button:focus-visible,
  .method-links a:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--green) 55%, transparent);
    outline-offset: -3px;
  }

  .method-panel[hidden] {
    display: none;
  }

  .method-panel__prompt {
    margin: 0;
    padding: 22px 0 18px;
    color: var(--green);
    font-weight: 700;
  }

  .method-panel__columns {
    display: grid;
    grid-template-columns: minmax(190px, .82fr) minmax(280px, 1.25fr) minmax(290px, 1.35fr);
    gap: 0;
    padding: 10px 0;
    border-block: 1px solid var(--line);
    color: var(--muted);
    font: 800 10px/1.4 ui-monospace;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .method-panel__columns span {
    padding-inline: 18px;
  }

  .method-flow {
    border-bottom: 1px solid var(--line);
  }

  .method-group {
    display: grid;
    grid-template-columns: minmax(190px, .82fr) minmax(0, 2.6fr);
    border-bottom: 1px solid var(--line);
  }

  .method-group:last-child {
    border-bottom: 0;
  }

  .method-group h3 {
    position: relative;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 0;
    padding: 25px 28px 25px 18px;
    border-right: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.65;
  }

  .method-group h3::after {
    content: "";
    position: absolute;
    right: 10px;
    top: 31px;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--green);
    border-right: 1px solid var(--green);
    background: var(--surface);
    transform: rotate(45deg);
  }

  .method-group h3 span {
    flex: none;
    padding-top: 5px;
    color: var(--green);
    font: 700 10px/1 ui-monospace;
  }

  .method-group__branches {
    min-width: 0;
  }

  .method-branch {
    display: grid;
    grid-template-columns: minmax(280px, .98fr) minmax(290px, 1.06fr);
    min-height: 82px;
    border-bottom: 1px solid var(--line);
  }

  .method-branch:last-child {
    border-bottom: 0;
  }

  .method-branch > p {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 19px 32px 19px 18px;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .method-branch > p::after {
    content: "→";
    position: absolute;
    right: 9px;
    top: 50%;
    color: var(--green);
    transform: translateY(-50%);
  }

  .method-links {
    display: grid;
    align-content: center;
    padding: 10px 0;
  }

  .method-links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px;
    gap: 10px;
    align-items: center;
    min-height: 39px;
    padding: 8px 18px;
    color: var(--green);
    font: 700 13px/1.45 system-ui, sans-serif;
  }

  .method-links a:hover {
    background: color-mix(in srgb, var(--mint) 42%, transparent);
  }

  .method-links a span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .method-links a b {
    font-size: 15px;
    text-align: right;
  }

  .method-navigator__note {
    max-width: 980px;
    margin: 22px 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--amber);
    color: var(--muted);
    font-size: 12px;
    line-height: 1.75;
  }

  @media (max-width: 1080px) {
    .method-panel__columns,
    .method-group {
      grid-template-columns: minmax(170px, .65fr) minmax(0, 2.35fr);
    }

    .method-panel__columns span:nth-child(2) {
      display: none;
    }

    .method-panel__columns span:nth-child(3) {
      grid-column: 2;
    }

    .method-branch {
      grid-template-columns: minmax(230px, 1fr) minmax(250px, 1.1fr);
    }
  }

  @media (max-width: 760px) {
    .method-navigator {
      padding: 50px 20px;
    }

    .method-navigator__header {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-bottom: 28px;
    }

    .method-navigator__header h2 {
      font-size: 30px;
    }

    .method-navigator__tabs {
      grid-template-columns: 1fr;
    }

    .method-navigator__tabs button {
      min-height: 50px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .method-navigator__tabs button:last-child {
      border-bottom: 0;
    }

    .method-panel__prompt {
      padding-block: 19px;
      font-size: 14px;
      line-height: 1.65;
    }

    .method-panel__columns {
      display: none;
    }

    .method-flow {
      border-top: 1px solid var(--line);
    }

    .method-group {
      grid-template-columns: 1fr;
    }

    .method-group h3 {
      padding: 19px 16px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      background: color-mix(in srgb, var(--mint) 38%, var(--surface));
    }

    .method-group h3::after {
      display: none;
    }

    .method-branch {
      grid-template-columns: 1fr;
    }

    .method-branch > p {
      padding: 16px 38px 10px 16px;
      border-right: 0;
      font-size: 13px;
    }

    .method-branch > p::after {
      content: "↓";
      right: 17px;
    }

    .method-links {
      padding: 0 0 10px;
    }

    .method-links a {
      min-height: 42px;
      padding: 9px 16px 9px 28px;
      font-size: 13px;
    }
  }
</style>
